# Public site URL (canonical, sitemap, OG). Default: https://buildream.vercel.app
PUBLIC_SITE_URL=https://buildream.vercel.app

# Contact form provider: web3forms | formspree | netlify (default: web3forms)
PUBLIC_FORM_PROVIDER=web3forms

# Web3Forms access key (public by design; required when provider = web3forms)
PUBLIC_WEB3FORMS_KEY=

# Formspree form id, e.g. xyzabcde (required when provider = formspree)
PUBLIC_FORMSPREE_ID=

# Cal.com booking link. Leave empty to hide the Cal.com link.
PUBLIC_CAL_URL=
