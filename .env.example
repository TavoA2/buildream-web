# URL pública del sitio (canonical, sitemap, Open Graph)
SITE_URL=https://buildream-web.vercel.app
# Access key de Web3Forms para el formulario de contacto (se pide en web3forms.com).
# Es pública por diseño (va en el HTML del formulario). Sin ella, el formulario muestra el aviso de WhatsApp.
PUBLIC_WEB3FORMS_KEY=
