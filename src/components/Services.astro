---
import { t, route, type Lang } from '../lib/i18n';
import { lineIcon } from '../lib/icons';

interface Props { lang: Lang; standalone?: boolean }
const { lang, standalone = false } = Astro.props;
const d = t(lang).services;
const H = standalone ? 'h1' : 'h2';
const contactUrl = route(lang, 'contact');
---
<section id="servicios" class:list={['section', !standalone && 'border-t border-line']}>
  <div class="wrap">
    <H class="h2 max-w-[18ch]">{d.title}</H>
    <p class="lead mt-5">{d.lead}</p>
    <nav aria-label={d.title} class="mt-8 flex flex-wrap gap-2">
      {d.groups.map((g) => (
        <a href={`#${g.id}`} class="rounded-full border border-line bg-surface px-4 py-2 text-sm font-semibold no-underline transition-colors hover:border-accent hover:text-accent-strong">{g.title}</a>
      ))}
    </nav>

    {d.groups.map((g) => (
      <div id={g.id} class="mt-16 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-28">
            <h2 class="text-[2rem]">{g.title}</h2>
            <p class="mt-3 max-w-xs text-muted">{g.lead}</p>
          </div>
        </div>
        <ul class="border-t border-line lg:col-span-8">
          {g.items.map((s) => (
            <li class="group grid gap-x-6 gap-y-3 border-b border-line py-8 sm:grid-cols-[3rem_1fr_auto] sm:items-start">
              <span class="grid size-12 place-items-center rounded-full bg-accent-soft text-accent-strong transition-transform duration-300 group-hover:-translate-y-0.5">
                <Fragment set:html={lineIcon(s.icon, 'size-6')} />
              </span>
              <div>
                <h3 class="font-display text-[1.65rem] leading-tight">{s.title}</h3>
                <p class="mt-2 max-w-[58ch] text-muted">{s.text}</p>
              </div>
              <a href={contactUrl} data-service={s.title} class="link self-center justify-self-start whitespace-nowrap text-[0.97rem] sm:justify-self-end">{d.ask}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-service]').forEach((a) =>
    a.addEventListener('click', () => {
      try {
        sessionStorage.setItem('buildream:service', a.dataset.service!);
      } catch {
        /* storage unavailable */
      }
    }),
  );
</script>
