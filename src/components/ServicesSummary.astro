---
import { t, route, type Lang } from '../lib/i18n';
import { lineIcon } from '../lib/icons';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).services;
const base = route(lang, 'services');
---
<section class="section border-t border-line">
  <div class="wrap">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="h2 max-w-[16ch]">{d.summaryTitle}</h2>
        <p class="lead mt-5">{d.lead}</p>
      </div>
      <a href={base} class="btn btn-secondary shrink-0 self-start md:self-auto">{d.all}</a>
    </div>
    <div class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-panel)] border border-line bg-line lg:grid-cols-3">
      {d.groups.map((g) => (
        <a href={`${base}#${g.id}`} class="group flex flex-col bg-paper p-7 no-underline transition-colors hover:bg-surface sm:p-8">
          <h3 class="text-[1.75rem]">{g.title}</h3>
          <p class="mt-2 text-muted">{g.lead}</p>
          <ul class="mt-7 space-y-4">
            {g.items.map((s) => (
              <li class="flex items-center gap-3.5">
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-accent-soft text-accent-strong"><Fragment set:html={lineIcon(s.icon, 'size-[1.1rem]')} /></span>
                <span class="font-medium">{s.title}</span>
              </li>
            ))}
          </ul>
        </a>
      ))}
    </div>
  </div>
</section>
