---
import { alternatePath, anchors, locales, t, type Locale, type SectionId } from '../../i18n/utils';

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: className } = Astro.props;
const target: Locale = locales.find((l) => l !== locale)!;
const href = alternatePath(Astro.url.pathname, target);
// current-locale anchor -> target-locale anchor, so the click handler needs no i18n tables.
const map = Object.fromEntries(
  (Object.keys(anchors) as SectionId[]).map((id) => [anchors[id][locale], anchors[id][target]]),
);
---
<div class:list={['flex items-center gap-1 text-sm font-semibold', className]}>
  <span class="text-ink" aria-hidden="true">{locale.toUpperCase()}</span>
  <span class="text-hairline" aria-hidden="true">/</span>
  <a
    href={href}
    hreflang={target}
    lang={target}
    aria-label={t(locale, 'a11y.switchLang')}
    data-lang-toggle
    data-map={JSON.stringify(map)}
    class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm text-ink-muted no-underline hover:text-ink"
  >{target.toUpperCase()}</a>
</div>
