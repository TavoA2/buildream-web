---
import { t, route, type Lang } from '../lib/i18n';
import { lineIcon } from '../lib/icons';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).hero;
const p = d.pipeline;
const last = p.steps.length - 1;
---
<section class="hero relative overflow-hidden pb-20 pt-12 sm:pt-16 lg:flex lg:min-h-[calc(100svh-4.5rem)] lg:items-center lg:pb-24">
  <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="wrap relative grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <h1 class="max-w-[13ch] text-[clamp(2.9rem,7.2vw,5.6rem)] leading-[0.98]">{d.title}</h1>
      <p class="lead mt-7">{d.lead}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={route(lang, 'diagnosis')} class="btn btn-primary">{d.primary}</a>
        <a href={route(lang, 'services')} class="btn btn-secondary bg-paper">{d.secondary}</a>
      </div>
      <p class="mt-8 flex max-w-xl items-start gap-2.5 text-[0.95rem] text-muted">
        <Fragment set:html={lineIcon('circle-check', 'mt-0.5 size-5 shrink-0 text-accent')} />
        {d.fact}
      </p>
    </div>

    <!-- The one authored moment: an idea running through a deploy pipeline, as a terminal -->
    <div class="lg:col-span-5">
      <figure id="hero-terminal" class="terminal overflow-hidden rounded-[var(--radius-panel)] bg-band text-white shadow-[0_30px_60px_-25px_rgb(11_20_48/0.5)] ring-1 ring-black/5" aria-label={p.label}>
        <div class="flex items-center gap-2 border-b border-white/10 px-5 py-3">
          <span class="size-2.5 rounded-full bg-white/25"></span>
          <span class="size-2.5 rounded-full bg-white/25"></span>
          <span class="size-2.5 rounded-full bg-signal"></span>
          <span class="ml-3 font-mono text-xs text-band-muted">{p.window}</span>
        </div>
        <div class="px-5 pb-6 pt-5 sm:px-6">
          <p class="font-mono text-[0.8rem] leading-relaxed text-band-muted">
            <span class="text-signal">$</span> {p.command}
          </p>
          <p class="mt-1 min-h-[3.2em] font-mono text-[0.84rem] leading-relaxed text-white"><span data-type data-text={`“${p.ideaText}”`}>“{p.ideaText}”</span><span class="caret ml-0.5 inline-block h-[1.05em] w-[0.5em] translate-y-[0.15em] bg-signal" aria-hidden="true"></span></p>

          <ol class="relative mt-6">
            {p.steps.map((s, i) => (
              <li class="step relative grid grid-cols-[1.5rem_1fr_auto] gap-x-3.5 pb-5 last:pb-0" style={`--i:${i}`}>
                {i < last && <span class="absolute left-[0.6875rem] top-6 bottom-0.5 w-px bg-white/15" aria-hidden="true"><span class="fill block h-full w-full origin-top bg-signal"></span></span>}
                <span class="status relative grid size-6 place-items-center" aria-hidden="true">
                  <span class="absolute inset-0.5 rounded-full border border-white/25"></span>
                  {i < last
                    ? <span class="done absolute inset-0 grid place-items-center rounded-full bg-signal text-band"><Fragment set:html={lineIcon('check', 'size-3.5')} /></span>
                    : <span class="done running absolute inset-0 grid place-items-center text-signal"><Fragment set:html={lineIcon('loader-circle', 'size-5')} /></span>}
                </span>
                <div>
                  <p class="font-mono text-[0.9rem] font-semibold leading-6">{s.name.toLowerCase()}</p>
                  <p class="text-[0.88rem] leading-snug text-band-muted">{s.detail}</p>
                </div>
                <span class="badge mt-0.5 h-fit rounded-md bg-white/8 px-2 py-0.5 font-mono text-[0.7rem] text-signal">
                  {i < last ? p.done : p.running}
                </span>
              </li>
            ))}
          </ol>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  /* Blueprint grid: quiet, fades out toward the edges */
  .grid-bg {
    background-image:
      linear-gradient(to right, rgb(11 20 48 / 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(11 20 48 / 0.06) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 75% 70% at 65% 40%, #000 30%, transparent 80%);
  }
  .step .done,
  .step .badge {
    opacity: 0;
    animation: appear 0.45s var(--ease-out-expo) forwards;
    animation-delay: calc(var(--t0, 0.6s) + var(--i) * 0.55s);
  }
  .step .done {
    transform: scale(0.6);
  }
  .step .fill {
    transform: scaleY(0);
    animation: grow 0.5s var(--ease-out-expo) forwards;
    animation-delay: calc(var(--t0, 0.6s) + 0.25s + var(--i) * 0.55s);
  }
  .running :global(svg) {
    animation: spin 1.4s linear infinite;
  }
  .caret {
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  @keyframes appear {
    to { opacity: 1; transform: none; }
  }
  @keyframes grow {
    to { transform: scaleY(1); }
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .step .done, .step .badge { opacity: 1; transform: none; }
    .step .fill { transform: none; }
    .running :global(svg) { animation: none; }
    .caret { animation: none; }
  }
</style>

<script>
  // Type the idea, then let the pipeline steps run (their CSS delays start from --t0).
  const term = document.getElementById('hero-terminal');
  const el = term?.querySelector<HTMLElement>('[data-type]');
  if (term && el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const text = el.dataset.text!;
    const speed = 28;
    term.style.setProperty('--t0', `${(text.length * speed + 500) / 1000}s`);
    el.textContent = '';
    let n = 0;
    const tick = () => {
      el.textContent = text.slice(0, ++n);
      if (n < text.length) setTimeout(tick, speed);
    };
    setTimeout(tick, 400);
  }
</script>
