---
import { t, route, whatsappLink, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const all = t(lang);
const d = all.ctaBand;
---
<section class="pb-[clamp(4.5rem,10vw,8rem)]">
  <div class="wrap">
    <div class="on-band grid gap-8 rounded-[var(--radius-panel)] bg-band px-7 py-12 text-white sm:px-12 md:grid-cols-[1fr_auto] md:items-center md:py-14">
      <div>
        <h2 class="max-w-[22ch] text-[clamp(1.9rem,3.6vw,2.75rem)]">{d.title}</h2>
        <p class="mt-4 max-w-xl text-band-muted">{d.text}</p>
      </div>
      <div class="flex flex-col gap-3">
        <a href={route(lang, 'diagnosis')} class="btn bg-white text-ink hover:bg-accent-soft">{d.primary}</a>
        <a href={whatsappLink(all.contact.whatsappText)} target="_blank" rel="noopener" class="btn text-white shadow-[inset_0_0_0_1px_rgb(255_255_255/0.4)] hover:bg-white/10">{d.secondary}</a>
      </div>
    </div>
  </div>
</section>
