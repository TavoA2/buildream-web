---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import es from '../../content/industries/es.json';
import en from '../../content/industries/en.json';
import { anchors, sectionHref, t, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const industries = locale === 'es' ? es : en;
---
<section
  id={anchors.audience[locale]}
  data-section="audience"
  aria-labelledby="audience-title"
  class="py-16 md:py-24 lg:py-32"
>
  <div class="mx-auto max-w-[1200px] px-4 lg:px-6">
    <SectionHeading id="audience-title" title={t(locale, 'audience.title')} intro={t(locale, 'audience.intro')} />

    <ul class="mt-12 grid md:mt-16 md:grid-cols-2 md:gap-x-12 lg:gap-x-16">
      {industries.map((item) => (
        <li data-audience-item class="group flex min-h-20 items-center gap-4 border-t border-b border-hairline py-5 -mb-px">
          <Icon name={item.icon} size={28} class="text-pine" />
          <span class="flex-1 font-sans text-lg font-semibold leading-[1.3] text-ink">{item.name}</span>
          <Icon
            name="arrow-right"
            size={20}
            class="-translate-x-1 text-ink-muted opacity-0 transition-[transform,opacity] duration-200 group-hover:translate-x-0 group-hover:opacity-100 group-focus-within:translate-x-0 group-focus-within:opacity-100 motion-reduce:transition-none"
          />
        </li>
      ))}
    </ul>

    <div class="mt-12">
      <Button href={sectionHref('contact', locale)} data-audience-cta>
        {t(locale, 'audience.cta')}
        <Icon name="arrow-right" size={18} />
      </Button>
    </div>
  </div>
</section>
