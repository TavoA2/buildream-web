---
import SectionHeading from '../ui/SectionHeading.astro';
import { anchors, t, type Locale, type UiKey } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const STAGES = ['plan', 'build', 'deploy', 'grow'] as const;
const stages = STAGES.map((id) => {
  const k = (field: string) => t(locale, `process.stages.${id}.${field}` as UiKey);
  return { id, job: k('job'), title: k('title'), line: k('line'), caption: k('caption') };
});
const last = stages.length - 1;
const status = {
  pending: t(locale, 'process.status.pending'),
  running: t(locale, 'process.status.running'),
  passed: t(locale, 'process.status.passed'),
};
---
<section
  id={anchors.process[locale]}
  data-section="process"
  aria-labelledby="process-title"
  class="py-16 md:py-24 lg:py-32"
>
  <div class="mx-auto max-w-[1200px] px-4 lg:px-6">
    <SectionHeading id="process-title" title={t(locale, 'process.title')} intro={t(locale, 'process.intro')} />

    <!--
      A CI run, rendered finished. Server default is `passed` so no-JS and reduced motion show the end state;
      pipeline.ts replays it once (pending -> running -> passed). Status is also in text (data-status).
    -->
    <ol
      data-pipeline
      data-pending={status.pending}
      data-running={status.running}
      data-passed={status.passed}
      class="mt-12 grid md:mt-16 lg:grid-cols-4"
    >
      {stages.map((s, i) => (
        <li data-stage={s.id} data-state="passed" class="group relative flex flex-col pb-10 last:pb-0 lg:pb-0">
          <div class="flex h-5 items-center gap-3" aria-hidden="true">
            <span class="relative grid size-3 shrink-0 place-items-center rounded-full border border-hairline bg-bone transition-colors duration-200 ease-out group-data-[state=passed]:border-pine group-data-[state=passed]:bg-pine group-data-[state=running]:border-pine group-data-[state=running]:delay-200">
              <span class="absolute size-1 rounded-full bg-pine opacity-0 transition-opacity duration-200 group-data-[state=running]:opacity-100 group-data-[state=running]:delay-200"></span>
              <svg viewBox="0 0 24 24" width="8" height="8" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="size-2 scale-50 text-white opacity-0 transition-[opacity,transform] duration-200 ease-out group-data-[state=passed]:scale-100 group-data-[state=passed]:opacity-100">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </span>
            <span class="font-mono text-[0.8125rem] leading-[1.4] text-ink-muted">{s.job}</span>
            {i < last && (
              <span class="relative hidden h-px flex-1 bg-hairline lg:block">
                <span class="absolute inset-0 origin-left scale-x-0 bg-pine transition-transform duration-300 ease-out group-data-[state=passed]:scale-x-100"></span>
              </span>
            )}
          </div>
          {i < last && (
            <span aria-hidden="true" class="absolute top-4 -bottom-1 left-[5.5px] w-px bg-hairline lg:hidden">
              <span class="absolute inset-0 origin-top scale-y-0 bg-pine transition-transform duration-300 ease-out group-data-[state=passed]:scale-y-100"></span>
            </span>
          )}
          <div class="mt-3 flex flex-1 flex-col pl-6 lg:mt-6 lg:pr-8">
            <h3 class="font-sans text-xl font-semibold leading-[1.3] text-ink">{s.title}</h3>
            <p data-status class="sr-only">{status.passed}</p>
            <p class="mt-2 max-w-[40ch] text-ink-muted">{s.line}</p>
            <p class="mt-3 text-[0.9375rem] leading-[1.5] font-medium text-ink lg:mt-auto lg:pt-4">{s.caption}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<script>
  import '../../scripts/pipeline';
</script>
