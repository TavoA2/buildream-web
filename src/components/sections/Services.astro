---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getLocalizedCollection } from '../../lib/content';
import { anchors, pagePath, t, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const entries = await getLocalizedCollection('services', locale);
const items = entries.map((e) => ({
  ...e.data,
  href: `${pagePath('home', locale)}?servicio=${e.data.id}#${anchors.contact[locale]}`,
}));
const [lead, ...rest] = items;
const consult = t(locale, 'services.consult');
---
<section
  id={anchors.services[locale]}
  data-section="services"
  aria-labelledby="services-title"
  class="py-16 md:py-24 lg:py-32"
>
  <div class="mx-auto max-w-[1200px] px-4 lg:px-6">
    <SectionHeading id="services-title" title={t(locale, 'services.title')} intro={t(locale, 'services.intro')} />

    <ul class="mt-12 grid md:mt-16 md:grid-cols-2 md:gap-x-12 lg:gap-x-16">
      {lead && (
        <li data-service-id={lead.id} class="border-t border-ink pt-8 pb-12 md:col-span-2 md:pb-16 lg:grid lg:grid-cols-12 lg:gap-x-8">
          <div class="lg:col-span-5">
            <Icon name={lead.icon} size={28} class="text-pine" />
            <h3 class="mt-5 font-display text-[clamp(2rem,1.7rem+1.2vw,2.5rem)] font-normal leading-[1.1] tracking-[-0.005em] text-balance text-ink">
              {lead.title}
            </h3>
          </div>
          <div class="mt-5 lg:col-span-6 lg:col-start-7 lg:mt-12">
            <p class="max-w-[60ch] text-[clamp(1.0625rem,1rem+0.35vw,1.25rem)] leading-[1.6] text-ink">{lead.summary}</p>
            <Button href={lead.href} variant="secondary" data-consult class="mt-8">
              {consult}<span class="sr-only">: {lead.title}</span>
              <Icon name="arrow-right" size={18} />
            </Button>
          </div>
        </li>
      )}
      {rest.map((s) => (
        <li data-service-id={s.id} class="flex flex-col border-t border-hairline pt-8 pb-10 md:pb-12">
          <Icon name={s.icon} size={28} class="text-pine" />
          <h3 class="mt-5 font-sans text-xl font-semibold leading-[1.3] text-ink">{s.title}</h3>
          <p class="mt-3 mb-6 max-w-[52ch] text-ink-muted">{s.summary}</p>
          <a
            href={s.href}
            data-consult
            class="group mt-auto inline-flex min-h-11 items-center gap-2 self-start rounded-sm font-semibold text-pine-ink underline decoration-1 underline-offset-[6px] transition-[text-decoration-thickness] duration-150 hover:decoration-2"
          >
            <span>{consult}<span class="sr-only">: {s.title}</span></span>
            <Icon name="arrow-right" size={18} class="transition-transform duration-200 group-hover:translate-x-1" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
