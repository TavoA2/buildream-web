---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import TypeLabel from '../ui/TypeLabel.astro';
import { getLocalizedCollection } from '../../lib/content';
import { anchors, t, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const projects = await getLocalizedCollection('projects', locale);
const newTab = t(locale, 'a11y.externalLink');
const linkClass =
  'inline-flex min-h-10 items-center font-sans text-[0.9375rem] font-semibold text-pine-ink underline decoration-1 underline-offset-4 hover:text-ink';
---
{projects.length > 0 && (
<section
  id={anchors.projects[locale]}
  data-section="projects"
  aria-labelledby="projects-title"
  class="py-16 md:py-24 lg:py-32"
>
  <div class="mx-auto max-w-[1200px] px-4 lg:px-6">
    <SectionHeading id="projects-title" title={t(locale, 'projects.title')} intro={t(locale, 'projects.intro')} />

    <ul class="mt-12 grid gap-6 md:mt-16 md:grid-cols-2 xl:grid-cols-3">
      {projects.map((p) => {
        const d = p.data;
        return (
          <li data-reveal data-project class="flex flex-col rounded-md border border-hairline bg-bone">
            {d.image ? (
              <Image
                src={d.image}
                alt=""
                widths={[480, 800]}
                sizes="(min-width: 1280px) 384px, (min-width: 768px) 50vw, 100vw"
                class="aspect-[16/10] w-full rounded-t-md object-cover"
              />
            ) : (
              <div
                data-project-placeholder
                aria-hidden="true"
                class="flex aspect-[16/10] w-full items-end rounded-t-md bg-bone-deep p-5 font-display text-[clamp(1.75rem,1.2rem+1.6vw,2.5rem)] leading-[1.1] break-words text-ink"
              >{d.title}</div>
            )}
            <div class="flex flex-1 flex-col p-5 md:p-6">
              <div><TypeLabel type={d.type} locale={locale} /></div>
              <h3 class="mt-4 font-sans text-xl font-semibold leading-[1.3] break-words text-ink">{d.title}</h3>
              <p class="mt-2 text-ink-muted">{d.summary}</p>
              {d.tags.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
                  {d.tags.map((tag) => (
                    <li class="font-mono text-[0.8125rem] leading-[1.4] text-ink-muted">{tag}</li>
                  ))}
                </ul>
              )}
              {(d.url || d.repo) && (
                <div class="mt-auto flex flex-wrap gap-x-6 pt-5">
                  {d.url && (
                    <a href={d.url} target="_blank" rel="noopener noreferrer" data-project-link="site" class={linkClass}>
                      {t(locale, 'projects.viewSite')}<span class="sr-only">: {d.title} ({newTab})</span>
                    </a>
                  )}
                  {d.repo && (
                    <a href={d.repo} target="_blank" rel="noopener noreferrer" data-project-link="repo" class={linkClass}>
                      {t(locale, 'projects.viewRepo')}<span class="sr-only">: {d.title} ({newTab})</span>
                    </a>
                  )}
                </div>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>
)}
