---
import { render } from 'astro:content';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getLocalizedCollection } from '../../lib/content';
import { anchors, t, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const entries = await getLocalizedCollection('faq', locale);
const items = await Promise.all(
  entries.map(async (entry) => ({ question: entry.data.question, Content: (await render(entry)).Content })),
);
---
{items.length > 0 && (
<section
  id={anchors.faq[locale]}
  data-section="faq"
  aria-labelledby="faq-title"
  class="py-16 md:py-24 lg:py-32"
>
  <div class="mx-auto max-w-[1200px] px-4 lg:px-6 lg:grid lg:grid-cols-12 lg:gap-x-8">
    <div class="lg:col-span-4">
      <SectionHeading id="faq-title" title={t(locale, 'faq.title')} intro={t(locale, 'faq.intro')} />
    </div>

    <div data-reveal class="mt-10 border-t border-hairline lg:col-span-7 lg:col-start-6 lg:mt-0">
      {items.map(({ question, Content }) => (
        <details data-faq-item class="group border-b border-hairline">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden">
            <h3 class="font-sans text-[1.0625rem] font-semibold leading-[1.4] text-ink md:text-lg">{question}</h3>
            <Icon name="chevron-down" size={22} class="faq-chevron text-pine" />
          </summary>
          <div class="faq-body max-w-[62ch] pb-6 text-ink-muted [&_a]:text-pine-ink [&_a]:underline [&_a]:underline-offset-4 [&_p+p]:mt-3">
            <Content />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
)}

<style is:global>
  [data-faq-item] > summary:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .faq-chevron {
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-faq-item][open] .faq-chevron {
    transform: rotate(180deg);
  }
  /* Height/opacity transition where ::details-content is supported; elsewhere it simply toggles. */
  @media (prefers-reduced-motion: no-preference) {
    @supports selector(::details-content) {
      [data-faq-item] {
        interpolate-size: allow-keywords;
      }
      [data-faq-item]::details-content {
        height: 0;
        opacity: 0;
        overflow: clip;
        transition:
          height 300ms cubic-bezier(0.16, 1, 0.3, 1),
          opacity 300ms cubic-bezier(0.16, 1, 0.3, 1),
          content-visibility 300ms allow-discrete;
      }
      [data-faq-item][open]::details-content {
        height: auto;
        opacity: 1;
      }
    }
  }
</style>
