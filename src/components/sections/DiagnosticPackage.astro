---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import MiniDiagnostic from './MiniDiagnostic.astro';
import { site } from '../../config/site';
import { SERVICE_PARAM } from '../../lib/form-prefill';
import { anchors, format, pagePath, sectionHref, t, type Locale, type UiKey } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const deliverables: UiKey[] = [
  'diagnostic.includes.summary',
  'diagnostic.includes.opportunities',
  'diagnostic.includes.tools',
  'diagnostic.includes.roadmap',
  'diagnostic.includes.followUp',
];
const ctaHref = `${pagePath('home', locale)}?${SERVICE_PARAM}=ai-diagnostic#${anchors.contact[locale]}`;
---
<section
  id={anchors.diagnostic[locale]}
  data-section="diagnostic"
  aria-labelledby="diagnostic-title"
  class="bg-bone-deep py-16 md:py-24 lg:py-32"
>
  <div class="mx-auto max-w-[1200px] px-4 lg:px-6">
    <div data-diagnostic-package class="lg:grid lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-span-7">
        <SectionHeading id="diagnostic-title" title={t(locale, 'diagnostic.title')} intro={t(locale, 'diagnostic.intro')} />

        <h3 class="mt-10 font-sans text-xl font-semibold leading-[1.3] text-ink md:mt-12">{t(locale, 'diagnostic.includesTitle')}</h3>
        <ul class="mt-4 max-w-[52ch]">
          {deliverables.map((key) => (
            <li class="flex items-center gap-3 border-b border-hairline py-3 first:border-t">
              <Icon name="check" size={20} class="text-pine" />
              <span class="text-ink">{t(locale, key)}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-10 self-end rounded-md border border-hairline bg-bone p-6 md:max-w-md md:p-8 lg:col-span-4 lg:max-w-none lg:col-start-9 lg:mt-0">
        <p class="text-ink-muted">{t(locale, 'diagnostic.priceLabel')}</p>
        <p data-diagnostic-price class="mt-1 font-display text-[clamp(3rem,2.4rem+2.4vw,4.25rem)] leading-none tracking-[-0.01em] text-ink tabular-nums">
          {format(t(locale, 'diagnostic.price'), { price: site.diagnosticPriceUsd })}
        </p>
        <Button href={ctaHref} data-diagnostic-cta class="mt-8 w-full">
          {t(locale, 'diagnostic.cta')}
          <Icon name="arrow-right" size={18} />
        </Button>
        <p class="mt-6 border-t border-hairline pt-5 text-[0.9375rem] leading-[1.5] text-ink-muted">
          {t(locale, 'diagnostic.freeCallQuestion')}{' '}
          <a
            href={sectionHref('contact', locale)}
            data-diagnostic-free-call
            class="font-semibold text-pine-ink underline decoration-1 underline-offset-4 hover:decoration-2"
          >{t(locale, 'diagnostic.freeCallLink')}</a>
        </p>
      </div>
    </div>

    <MiniDiagnostic locale={locale} />
  </div>
</section>
