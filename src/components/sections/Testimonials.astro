---
import SectionHeading from '../ui/SectionHeading.astro';
import { getLocalizedCollection } from '../../lib/content';
import { t, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Nothing is rendered (no wrapper, no heading) until real, published testimonials exist.
const items = (await getLocalizedCollection('testimonials', locale)).filter((e) => e.data.published === true);
---
{items.length > 0 && (
<section data-section="testimonials" aria-labelledby="testimonials-title" class="py-16 md:py-24 lg:py-32">
  <div class="mx-auto max-w-[1200px] px-4 lg:px-6">
    <SectionHeading id="testimonials-title" title={t(locale, 'testimonials.title')} />
    <ul class="mt-12 grid gap-8 md:grid-cols-2 lg:mt-16">
      {items.map((e) => (
        <li data-reveal data-testimonial>
          <figure class="border-l-2 border-pine pl-5">
            <blockquote class="font-serif text-xl leading-[1.5] text-ink">{e.data.quote}</blockquote>
            <figcaption class="mt-4 text-[0.9375rem] leading-[1.5] text-ink-muted">
              <span class="font-semibold text-ink">{e.data.name}</span> · {e.data.role}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
)}
