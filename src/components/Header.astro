---
import Logo from './Logo.astro';
import { t, route, type Lang, type Route } from '../lib/i18n';
import { lineIcon } from '../lib/icons';

interface Props { lang: Lang; altPath: string; current: Route }
const { lang, altPath, current } = Astro.props;
const d = t(lang);
const home = route(lang, 'home');
const keys: Route[] = ['services', 'diagnosis', 'projects', 'about', 'contact'];
const label: Record<string, string> = { home: d.nav.home, services: d.nav.services, diagnosis: d.nav.diagnosis, projects: d.nav.projects, about: d.nav.about, contact: d.nav.contact };
const links = keys.map((k) => ({ key: k, href: route(lang, k), label: label[k] }));
const mobileLinks = [{ key: 'home' as Route, href: home, label: d.nav.home }, ...links];
---
<header id="site-header" class="sticky top-0 z-40 border-b border-transparent bg-paper transition-[border-color,box-shadow] duration-300">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6">
    <a href={home} class="rounded-md" aria-label="Buildream">
      <Logo descriptor={d.brand.descriptor} />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-[0.97rem] font-medium">
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.key === current ? 'page' : undefined} class="nav-link relative py-2 text-ink/75 no-underline transition-colors hover:text-ink aria-[current=page]:text-ink">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={altPath} hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'}
         aria-label={d.nav.switchLabel}
         class="rounded-md px-2 py-1 text-sm font-semibold text-muted no-underline transition-colors hover:text-ink">
        {lang === 'es' ? 'EN' : 'ES'}
      </a>
      <a href={route(lang, 'contact')} class="btn btn-primary hidden min-h-11 px-4 py-2 text-[0.95rem] sm:inline-flex">{d.nav.cta}</a>
      <button id="menu-open" type="button" class="grid size-11 place-items-center rounded-md lg:hidden" aria-controls="mobile-menu" aria-expanded="false" aria-label={d.nav.menu}>
        <Fragment set:html={lineIcon('menu', 'size-6')} />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="fixed inset-0 z-50 hidden flex-col bg-paper lg:hidden" role="dialog" aria-modal="true" aria-label={d.nav.menu}>
    <div class="wrap flex h-[4.5rem] items-center justify-between">
      <Logo descriptor={d.brand.descriptor} />
      <button id="menu-close" type="button" class="grid size-11 place-items-center rounded-md" aria-label={d.nav.close}>
        <Fragment set:html={lineIcon('x', 'size-6')} />
      </button>
    </div>
    <nav aria-label="Móvil" class="wrap flex flex-1 flex-col pt-6">
      <ul class="flex flex-col border-t border-line">
        {mobileLinks.map((l) => (
          <li class="border-b border-line">
            <a href={l.href} aria-current={l.key === current ? 'page' : undefined} data-close class="flex items-center justify-between py-4 font-display text-3xl no-underline aria-[current=page]:text-accent-strong">{l.label}</a>
          </li>
        ))}
      </ul>
      <a href={route(lang, 'contact')} data-close class="btn btn-primary mt-8 w-full">{d.nav.cta}</a>
    </nav>
  </div>
</header>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.25s var(--ease-out-expo);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const onScroll = () => {
    const scrolled = window.scrollY > 8;
    header.classList.toggle('border-line', scrolled);
    header.classList.toggle('border-transparent', !scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const menu = document.getElementById('mobile-menu')!;
  const openBtn = document.getElementById('menu-open')!;
  const closeBtn = document.getElementById('menu-close')!;
  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn).focus();
  };
  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  menu.querySelectorAll('[data-close]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.classList.contains('hidden')) setOpen(false);
  });
</script>
