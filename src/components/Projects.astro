---
import { t, type Lang } from '../lib/i18n';
import { lineIcon } from '../lib/icons';

interface Props { lang: Lang; standalone?: boolean }
const { standalone = false } = Astro.props;
const H = standalone ? 'h1' : 'h2';
const d = t(Astro.props.lang).projects;
type Kind = keyof typeof d.tags;
---
<section id="proyectos" class:list={['section', !standalone && 'bg-surface']}>
  <div class="wrap">
    <H class="h2">{d.title}</H>
    <p class="lead mt-5">{d.lead}</p>
    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {d.items.map((p) => (
        <li>
          <a href={p.url} target="_blank" rel="noopener"
             class="group flex h-full flex-col rounded-[var(--radius-panel)] border border-line bg-surface p-6 no-underline transition duration-300 hover:-translate-y-0.5 hover:shadow-lift sm:p-7">
            <!-- Mini pipeline diagram of the project -->
            <div class="flex items-center rounded-[0.75rem] bg-paper px-4 py-5" aria-hidden="true">
              {p.nodes.map((n, i) => (
                <>
                  {i > 0 && <span class="relative h-px flex-1 bg-line"><span class="absolute inset-y-0 left-0 w-0 bg-accent transition-[width] duration-500 group-hover:w-full" style={`transition-delay:${i * 90}ms`}></span></span>}
                  <span class={`shrink-0 rounded-md border px-2.5 py-1.5 text-xs font-semibold ${i === p.nodes.length - 1 ? 'border-accent bg-accent-soft text-accent-strong' : 'border-line bg-paper text-ink'}`}>{n}</span>
                </>
              ))}
            </div>
            <span class="mt-6 w-fit rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-semibold text-accent-strong">{d.tags[p.kind as Kind]}</span>
            <h3 class="mt-3 font-display text-[1.75rem] leading-tight">{p.title}</h3>
            <p class="mt-2 text-muted">{p.text}</p>
            <p class="mt-4 text-sm font-medium text-ink/70">{p.tech.join(', ')}</p>
            <span class="mt-auto flex items-center gap-1.5 pt-6 font-semibold text-accent-strong">
              {d.view}
              <Fragment set:html={lineIcon('arrow-up-right', 'size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5')} />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
