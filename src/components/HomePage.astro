---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalizedCollection } from '../lib/content';
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const faqEntries = await getLocalizedCollection('faq', locale);
const faq = faqEntries.map((e) => ({
  question: e.data.question,
  answer: (e.body ?? '')
    .replace(/[*_`#>]/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/\s+/g, ' ')
    .trim(),
}));
---
<BaseLayout
  locale={locale}
  page="home"
  title={t(locale, 'meta.home.title')}
  description={t(locale, 'meta.home.description')}
  faq={faq}
>
  <main id="main">
    <h1 class="font-display text-5xl p-8">{t(locale, 'hero.title')}</h1>
  </main>
</BaseLayout>
