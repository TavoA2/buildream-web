---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './sections/Hero.astro';
import Services from './sections/Services.astro';
import Stack from './sections/Stack.astro';
import Audience from './sections/Audience.astro';
import DiagnosticPackage from './sections/DiagnosticPackage.astro';
import Process from './sections/Process.astro';
import About from './sections/About.astro';
import Projects from './sections/Projects.astro';
import Testimonials from './sections/Testimonials.astro';
import { getLocalizedCollection } from '../lib/content';
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const faqEntries = await getLocalizedCollection('faq', locale);
const faq = faqEntries.map((e) => ({
  question: e.data.question,
  answer: (e.body ?? '')
    .replace(/[*_`#>]/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/\s+/g, ' ')
    .trim(),
}));
---
<BaseLayout
  locale={locale}
  page="home"
  title={t(locale, 'meta.home.title')}
  description={t(locale, 'meta.home.description')}
  faq={faq}
>
  <main id="main">
    <div data-nav-sentinel aria-hidden="true" class="h-px"></div>
    <Hero locale={locale} />
    <Services locale={locale} />
    <Stack locale={locale} />
    <Audience locale={locale} />
    <DiagnosticPackage locale={locale} />
    <Process locale={locale} />
    <About locale={locale} />
    <Projects locale={locale} />
    <Testimonials locale={locale} />
  </main>
</BaseLayout>
