---
import { t, type Lang } from '../lib/i18n';
import { lineIcon } from '../lib/icons';

interface Props { lang: Lang }
const d = t(Astro.props.lang).showcase;
const check = lineIcon('check', 'size-3.5');
const spin = lineIcon('loader-circle', 'size-4');
---
<section class="section border-t border-line">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="min-w-0 lg:col-span-5">
      <h2 class="h2">{d.title}</h2>
      <p class="lead mt-5">{d.lead}</p>
      <div role="tablist" aria-label={d.title} class="mt-9 flex flex-wrap gap-2 lg:flex-col">
        {d.cases.map((c, i) => (
          <button type="button" role="tab" id={`tab-${c.id}`} aria-controls="agent-run" aria-selected={i === 0 ? 'true' : 'false'} data-case={i}
            class="tab group flex shrink-0 items-center gap-3 rounded-[var(--radius-control)] border border-line bg-paper px-4 py-3 text-left font-semibold transition hover:border-accent aria-selected:border-ink aria-selected:bg-ink aria-selected:text-paper">
            <span class="hidden size-2 rounded-full bg-line transition group-aria-selected:bg-signal lg:block"></span>
            {c.tab}
          </button>
        ))}
      </div>
      <p class="mt-6 text-sm text-muted">{d.note}</p>
    </div>

    <div class="min-w-0 lg:col-span-7">
      <div id="agent-run" role="tabpanel" data-cases={JSON.stringify(d.cases)} data-check={check} data-spin={spin}
           class="on-band overflow-hidden rounded-[var(--radius-panel)] bg-band text-white shadow-[0_30px_60px_-25px_rgb(11_20_48/0.5)]">
        <div class="flex items-center justify-between border-b border-white/10 px-5 py-3">
          <div class="flex items-center gap-2">
            <span class="size-2.5 rounded-full bg-white/25"></span>
            <span class="size-2.5 rounded-full bg-white/25"></span>
            <span class="size-2.5 rounded-full bg-signal"></span>
            <span data-agent class="ml-3 font-mono text-xs text-band-muted"></span>
          </div>
          <button type="button" data-replay class="rounded-md px-2 py-1 font-mono text-xs text-band-muted transition hover:bg-white/10 hover:text-white">{d.replay}</button>
        </div>
        <div class="space-y-6 px-5 py-6 sm:px-7 sm:py-7">
          <div>
            <p class="font-mono text-[0.72rem] text-band-muted">{d.request}</p>
            <p data-request class="mt-2 rounded-[0.6rem] bg-white/6 px-4 py-3 text-[1.02rem] leading-snug"></p>
          </div>
          <ol data-steps class="space-y-3 font-mono text-[0.86rem]"></ol>
          <div data-result-wrap class="result rounded-[0.6rem] border border-signal/40 bg-signal/10 px-4 py-3">
            <p class="font-mono text-[0.72rem] text-signal">{d.result}</p>
            <p data-result class="mt-1 text-[1rem] leading-snug"></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .result {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s var(--ease-out-expo), transform 0.4s var(--ease-out-expo);
  }
  .result.show {
    opacity: 1;
    transform: none;
  }
  #agent-run :global(.spin svg) {
    animation: spin 1.2s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  type Case = { agent: string; request: string; steps: string[]; result: string };
  const panel = document.getElementById('agent-run')!;
  const cases: Case[] = JSON.parse(panel.dataset.cases!);
  const check = panel.dataset.check!;
  const spin = panel.dataset.spin!;
  const q = <T extends HTMLElement>(s: string) => panel.querySelector<T>(s)!;
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role=tab][data-case]'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let timers: number[] = [];
  let current = 0;

  function stepRow(text: string): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'flex items-start gap-3 text-band-muted transition-colors';
    li.innerHTML = '<span class="ic grid size-5 shrink-0 place-items-center rounded-full border border-white/25"></span><span class="tx pt-px"></span>';
    li.querySelector('.tx')!.textContent = text;
    return li;
  }

  function run(i: number) {
    timers.forEach(clearTimeout);
    timers = [];
    current = i;
    const c = cases[i];
    tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
    panel.setAttribute('aria-labelledby', tabs[i].id);
    q('[data-agent]').textContent = `~/agents/${c.agent}`;
    q('[data-request]').textContent = c.request;
    q('[data-result]').textContent = c.result;
    const list = q('[data-steps]');
    const rows = c.steps.map(stepRow);
    list.replaceChildren(...rows);
    const res = q('[data-result-wrap]');
    res.classList.remove('show');

    const setDone = (li: HTMLLIElement) => {
      const ic = li.querySelector<HTMLElement>('.ic')!;
      ic.className = 'ic grid size-5 shrink-0 place-items-center rounded-full bg-signal text-band';
      ic.innerHTML = check;
      li.classList.remove('text-band-muted');
      li.classList.add('text-white');
    };
    const setRunning = (li: HTMLLIElement) => {
      const ic = li.querySelector<HTMLElement>('.ic')!;
      ic.className = 'ic spin grid size-5 shrink-0 place-items-center text-signal';
      ic.innerHTML = spin;
      li.classList.add('text-white');
    };

    if (reduce) {
      rows.forEach(setDone);
      res.classList.add('show');
      return;
    }
    rows.forEach((li, k) => {
      timers.push(window.setTimeout(() => setRunning(li), 300 + k * 750));
      timers.push(window.setTimeout(() => setDone(li), 300 + k * 750 + 600));
    });
    timers.push(window.setTimeout(() => res.classList.add('show'), 300 + rows.length * 750 + 200));
  }

  tabs.forEach((t, k) => {
    t.addEventListener('click', () => run(k));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowDown' && e.key !== 'ArrowLeft' && e.key !== 'ArrowUp') return;
      e.preventDefault();
      const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : -1;
      const next = (k + dir + tabs.length) % tabs.length;
      tabs[next].focus();
      run(next);
    });
  });
  q('[data-replay]').addEventListener('click', () => run(current));

  // Start when the panel scrolls into view.
  const io = new IntersectionObserver((entries) => {
    if (entries.some((e) => e.isIntersecting)) {
      run(0);
      io.disconnect();
    }
  }, { threshold: 0.35 });
  io.observe(panel);
</script>
