---
import { t, route, contact, type Lang } from '../lib/i18n';
import { lineIcon } from '../lib/icons';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).about;
---
<section class="section">
  <div class="wrap">
    <h1 class="h2 text-[clamp(2.75rem,6vw,4.5rem)]">{d.title}</h1>
    <p class="mt-6 max-w-3xl font-display text-[clamp(1.4rem,2.4vw,1.9rem)] leading-snug">{d.lead}</p>

    <div class="mt-16 grid gap-10 border-t border-line pt-12 lg:grid-cols-12">
      <h2 class="text-[2rem] lg:col-span-4">{d.missionTitle}</h2>
      <p class="max-w-[60ch] text-[1.15rem] lg:col-span-8">{d.mission}</p>
    </div>

    <div class="mt-16 grid gap-10 border-t border-line pt-12 lg:grid-cols-12">
      <h2 class="text-[2rem] lg:col-span-4">{d.principlesTitle}</h2>
      <ul class="grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:col-span-8">
        {d.principles.map((p) => (
          <li>
            <span class="grid size-11 place-items-center rounded-full bg-accent-soft text-accent-strong"><Fragment set:html={lineIcon(p.icon, 'size-5')} /></span>
            <h3 class="mt-4 font-sans text-[1.15rem] font-semibold tracking-normal">{p.title}</h3>
            <p class="mt-1.5 text-muted">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-16 grid gap-10 border-t border-line pt-12 lg:grid-cols-12">
      <h2 class="text-[2rem] lg:col-span-4">{d.experienceTitle}</h2>
      <div class="lg:col-span-8">
        <p class="max-w-[60ch] text-[1.15rem]">{d.experience}</p>
        <ul class="mt-7 flex flex-wrap gap-2">
          {d.chips.map((c) => <li class="rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm font-medium">{c}</li>)}
        </ul>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={route(lang, 'contact')} class="btn btn-primary">{d.talk}</a>
          <a href={contact.portfolio} target="_blank" rel="noopener" class="btn btn-secondary">{d.founder}</a>
        </div>
      </div>
    </div>
  </div>
</section>
