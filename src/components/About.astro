---
import { t, contact, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const d = t(Astro.props.lang).about;
// Foto pendiente: guarda la imagen en src/assets/dixon.jpg y reemplaza el bloque del monograma
// por <Image src={photo} alt={d.photoAlt} /> (import { Image } from 'astro:assets').
---
<section id="sobre-mi" class="section border-t border-line">
  <div class="wrap grid items-center gap-12 md:grid-cols-12 lg:gap-16">
    <div class="md:col-span-5">
      <div class="relative mx-auto aspect-[4/5] max-w-sm overflow-hidden rounded-[var(--radius-panel)] bg-accent-soft md:mx-0" role="img" aria-label={d.photoAlt}>
        <span class="absolute inset-0 grid place-items-center font-display text-[7rem] font-medium text-accent-strong/80">DA</span>
        <span class="absolute bottom-0 left-0 right-0 h-1/3 bg-gradient-to-t from-accent/20 to-transparent"></span>
      </div>
    </div>
    <div class="md:col-span-7">
      <h2 class="h2">{d.title}</h2>
      <p class="mt-6 font-display text-[1.6rem] leading-tight">{d.name}</p>
      <p class="mt-1 font-medium text-muted">{d.role}</p>
      {d.bio.map((p) => <p class="mt-5 max-w-[60ch]">{p}</p>)}
      <ul class="mt-7 flex flex-wrap gap-2">
        {d.chips.map((c) => <li class="rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm font-medium">{c}</li>)}
      </ul>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={contact.portfolio} target="_blank" rel="noopener" class="btn btn-secondary">{d.portfolio}</a>
        <a href="#contacto" class="btn btn-primary">{d.talk}</a>
      </div>
    </div>
  </div>
</section>
