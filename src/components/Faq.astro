---
import { t, type Lang } from '../lib/i18n';
import { lineIcon } from '../lib/icons';

interface Props { lang: Lang }
const d = t(Astro.props.lang).faq;
---
<section class="section">
  <div class="wrap grid gap-10 lg:grid-cols-12">
    <h2 class="h2 lg:col-span-4">{d.title}</h2>
    <div class="border-t border-line lg:col-span-8">
      {d.items.map((f) => (
        <details class="group border-b border-line">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[1.2rem] font-semibold [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="grid size-9 shrink-0 place-items-center rounded-full border border-line transition group-open:rotate-45 group-open:border-accent group-open:text-accent">
              <Fragment set:html={lineIcon('plus', 'size-5')} />
            </span>
          </summary>
          <p class="max-w-[62ch] pb-7 text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
